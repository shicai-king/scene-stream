# Defaults for local GPU-free development. Scope deployment uses the generated config.
MOCK_WORKER_COUNT=2
AUTO_START=true
SESSION_ACTIVE_LIMIT=
HEARTBEAT_INTERVAL_S=5
LEASE_TTL_S=25
SESSION_CONNECT_TIMEOUT_S=45
FIRST_FRAME_TIMEOUT_S=180
RESET_RPC_TIMEOUT_S=30
MEDIA_STALL_TIMEOUT_S=45
WORKER_STARTUP_TIMEOUT_S=90
PIPELINE_READY_TIMEOUT_S=600
PROMPT_INTERVAL_S=0.5
PROMPT_TTL_S=20
LOG_PATH=logs/events.jsonl
