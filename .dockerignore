# Only files needed by the hub Dockerfile enter the build context.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!pyproject.toml
!uv.lock
!longlive/
longlive/*
!longlive/*.py
!web/
web/*
!web/index.html
!web/src/
web/src/*
!web/src/*.ts
!web/src/*.css
!configs/
configs/*
!configs/workers.example.yaml
**/*.local.*
**/.env*
